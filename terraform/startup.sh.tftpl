#!/bin/bash
set -euo pipefail

echo "=== Starting deployment script ==="

# 1. Update and install basic dependencies
apt-get update
apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release unzip

# 2. Install Docker & Docker Compose
echo "=== Installing Docker ==="
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  tee /etc/apt/sources.list.d/docker.list > /dev/null

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# 3. Create app folder and download deployment package from GCS
echo "=== Downloading application from GCS ==="
mkdir -p /opt/cflt-app
gsutil cp gs://${bucket_name}/${archive_name} /tmp/app_deploy.zip
unzip -o /tmp/app_deploy.zip -d /opt/cflt-app

# 4. Create environment file with Confluent Telemetry Credentials
echo "=== Creating .env configuration ==="
cat << 'EOF' > /opt/cflt-app/.env
CLOUD_API_KEY=${cloud_api_key}
CLOUD_API_SECRET=${cloud_api_secret}
METRICS_API_ENDPOINT=https://api.telemetry.confluent.cloud/v2/metrics/cloud
PROM_SCRAPE_INTERVAL=1m
PROM_SCRAPE_TIMEOUT=55s
PROM_RETENTION_TIME=180d
EOF

# 5. Create dynamic directories with write permissions for containers
echo "=== Preparing dynamic volumes ==="
mkdir -p /opt/cflt-app/.cflt-local/data
mkdir -p /opt/cflt-app/.cflt-local/prometheus
chmod -R 777 /opt/cflt-app/.cflt-local

# 6. Run the application containers using Docker Compose
echo "=== Starting Docker Compose ==="
cd /opt/cflt-app
docker compose up --build -d

echo "=== Deployment finished successfully ==="
